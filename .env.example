POSTGRES_DB=global_admin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_PORT=5432

APP_PORT=8080
CHATBOT_PORT=8000

# Docker default: Spring calls the chatbot container by service name.
# For IntelliJ local Spring + Docker chatbot-api, use:
# PYTHON_LLM_BASE_URL=http://localhost:8000
PYTHON_LLM_BASE_URL=http://chatbot-api:8000

# Local model is disabled by default for VPS/API-provider deployments.
LOCAL_MODEL_ENABLED=false
CHATBOT_BASE_MODEL=
CHATBOT_LORA_ADAPTER=
CHATBOT_TOKENIZER_PATH=
CHATBOT_MODELS_HOST_DIR=./chatbot/models

CHATBOT_KB_DIR=/app/kb/article
RETRIEVAL_MODE=keyword
RETRIEVAL_TOP_K=4
CHATBOT_TEST_MODE=0
MARKET_PRICE_PROVIDER=

MAX_NEW_TOKENS=256
TEMPERATURE=0.7
TOP_P=0.9
TOP_K=50

# Token limits by provider
CLAUDE_MAX_NEW_TOKENS=768
LOCAL_FALLBACK_MAX_TOKENS=128

# Local fallback settings (disabled by default on VPS CPU-only)
FALLBACK_TO_LOCAL_ENABLED=false
LOCAL_FALLBACK_TIMEOUT_SECONDS=45
LOCAL_PIPELINE_MAX_CACHE=2
LOCAL_PIPELINE_IDLE_TTL_SECONDS=180
LOCAL_PIPELINE_CLEANUP_INTERVAL_SECONDS=30

# Claude provider (system-level, env-only).
# Per-chatbot apiKey/apiModel/apiBaseUrl have been removed.
# Claude uses these env vars only:
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_API_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
# or alternatively:
# CLAUDE_API_KEY=

MESSENGER_VERIFY_TOKEN=woodchat_secret

# For fast mock verification only:
# CHATBOT_TEST_MODE=1
# MARKET_PRICE_PROVIDER=mock
# USE_MOCK_MARKET_PRICE=1

# Local spawned fallback only. Prefer PYTHON_LLM_BASE_URL for runtime/deploy.
# PYTHON_BIN=python
# MODEL_SERVER_DIR=../chatbot
