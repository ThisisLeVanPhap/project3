@startuml
left to right direction
skinparam packageStyle rectangle

actor "Người dùng cuối" as User

rectangle "Tư vấn sản phẩm theo cửa hàng" {

  usecase "Bắt đầu hội thoại mới" as UC1
  usecase "Gửi tin nhắn tư vấn" as UC2
  usecase "Cung cấp nhu cầu" as UC3
  usecase "Thay đổi nhu cầu" as UC4
  usecase "Nhận câu trả lời\ntư vấn" as UC5
  usecase "Nhận gợi ý sản phẩm" as UC6
  usecase "Yêu cầu gợi ý\nsản phẩm tương tự" as UC7
  usecase "Xem lịch sử\nhội thoại" as UC8
  usecase "Yêu cầu tạo\nđơn mua hàng" as UC9
  usecase "Cung cấp thông tin\nliên hệ" as UC10
  usecase "Yêu cầu chuyển\nnhân viên" as UC11

}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7
User --> UC8
User --> UC9
User --> UC10
User --> UC11

UC2 ..> UC3 : <<include>>
UC2 ..> UC5 : <<include>>

UC3 ..> UC4 : <<extend>>

UC5 ..> UC6 : <<extend>>

UC6 ..> UC7 : <<extend>>

UC9 ..> UC10 : <<include>>

UC2 ..> UC11 : <<extend>>

@enduml
