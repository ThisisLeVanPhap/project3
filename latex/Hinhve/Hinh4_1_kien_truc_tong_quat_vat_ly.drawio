<mxfile>
  <diagram name="Kiến trúc vật lý">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" arrowSize="1" page="1" pageWidth="1169" pageHeight="827">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== USER ===== -->
        <mxCell id="u2" value="Người dùng cuối" style="rounded=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#43A047;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="130" height="50" />
        </mxCell>

        <!-- ===== KÊNH TRUY CẬP ===== -->
        <mxCell id="b2" value="Trình duyệt&#10;(Web Chat / Admin UI)" style="rounded=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FB8C00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="140" width="130" height="50" />
        </mxCell>
        <mxCell id="m2" value="Messenger&#10;(Meta)" style="rounded=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="310" y="140" width="130" height="50" />
        </mxCell>
        <mxCell id="t2" value="Telegram&#10;(Bot)" style="rounded=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="140" width="130" height="50" />
        </mxCell>

        <!-- ===== NGROK ===== -->
        <mxCell id="n2" value="ngrok&#10;(Public HTTPS Tunnel)&#10;(chỉ dev, có domain thì bỏ)" style="rounded=1;whiteSpace=wrap;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=11;fontStyle=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="250" width="150" height="50" />
        </mxCell>

        <!-- ===== CLAUDE API EXTERNAL ===== -->
        <mxCell id="c2" value="Claude API&#10;(Anthropic)&#10;External LLM Service" style="rounded=1;whiteSpace=wrap;fillColor=#FCE4EC;strokeColor=#E91E63;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="250" width="140" height="50" />
        </mxCell>

        <!-- ===== VPS BOUNDARY ===== -->
        <mxCell id="v2" value="1 VPS / Server (Docker Compose)" style="swimlane;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#616161;fontSize=14;fontStyle=1;startSize=35;container=1;collapsible=0;horizontal=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="340" width="750" height="390" />
        </mxCell>

        <!-- ===== SPRING BOOT ===== -->
        <mxCell id="s2" value="Spring Boot App&#10;Java 21 - Port 8080&#10;Controller / Service / JPA&#10;Nhận webhook + REST API" style="rounded=1;whiteSpace=wrap;fillColor=#E8EAF6;strokeColor=#3F51B5;fontSize=10;" vertex="1" parent="v2">
          <mxGeometry x="40" y="50" width="170" height="80" />
        </mxCell>

        <!-- ===== FASTAPI ===== -->
        <mxCell id="f2" value="FastAPI Chatbot Runtime&#10;Python 3.11 - Port 8000&#10;Retrieval / Prompt / Fallback" style="rounded=1;whiteSpace=wrap;fillColor=#E8EAF6;strokeColor=#3F51B5;fontSize=10;" vertex="1" parent="v2">
          <mxGeometry x="410" y="50" width="170" height="80" />
        </mxCell>

        <!-- ===== POSTGRES ===== -->
        <mxCell id="p2" value="PostgreSQL 16&#10;Port 5432&#10;Tenant / User / Msg&#10;Lead / Artifact Meta" style="shape=cylinder;whiteSpace=wrap;fillColor=#FFF8E1;strokeColor=#F57F17;fontSize=10;boundedLbl=1;" vertex="1" parent="v2">
          <mxGeometry x="40" y="190" width="150" height="60" />
        </mxCell>

        <!-- ===== FILE SYSTEM ===== -->
        <mxCell id="fs2" value="File System (Volume)&#10;KB Artifacts / Catalog / RAG&#10;Model weights (optional)" style="rounded=1;whiteSpace=wrap;fillColor=#FFF8E1;strokeColor=#F57F17;fontSize=10;" vertex="1" parent="v2">
          <mxGeometry x="430" y="200" width="150" height="50" />
        </mxCell>

        <!-- ============================================ -->
        <!-- EDGES (đường nối) — tất cả đều có edge="1"    -->
        <!-- ============================================ -->

        <!-- User → Browser -->
        <mxCell id="e-ub2" edge="1" parent="1" source="u2" target="b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- User → Messenger -->
        <mxCell id="e-um2" edge="1" parent="1" source="u2" target="m2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- User → Telegram -->
        <mxCell id="e-ut2" edge="1" parent="1" source="u2" target="t2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Browser → Spring Boot -->
        <mxCell id="e-bs2" edge="1" parent="1" source="b2" target="s2" style="entryX=0.3;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Messenger → ngrok -->
        <mxCell id="e-mn2" edge="1" parent="1" source="m2" target="n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Telegram → ngrok -->
        <mxCell id="e-tn2" edge="1" parent="1" source="t2" target="n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ngrok → Spring Boot -->
        <mxCell id="e-ns2" edge="1" parent="1" source="n2" target="s2" style="entryX=0.25;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Spring Boot → PostgreSQL -->
        <mxCell id="e-sp2" edge="1" parent="v2" source="s2" target="p2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Spring Boot → FastAPI -->
        <mxCell id="e-sf2" edge="1" parent="v2" source="s2" target="f2" style="strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Spring Boot → File System (nét đứt) -->
        <mxCell id="e-sfs2" edge="1" parent="v2" source="s2" target="fs2" style="dashed=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- FastAPI → File System (hai chiều, nét đứt) -->
        <mxCell id="e-ffs2" edge="1" parent="v2" source="f2" target="fs2" style="dashed=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- FastAPI → Claude API (nét đứt, đỏ) -->
        <mxCell id="e-fc2" edge="1" parent="1" source="f2" target="c2" style="dashed=1;strokeColor=#C62828;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== CHÚ THÍCH ===== -->
        <mxCell id="lg2" value="Chú thích:" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="870" y="40" width="100" height="20" />
        </mxCell>
        <mxCell id="lg-a2" value="━━━ Nét liền: gọi trực tiếp" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="870" y="65" width="220" height="18" />
        </mxCell>
        <mxCell id="lg-b2" value="━ ━ Nét đứt: external / gián tiếp" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="870" y="85" width="220" height="18" />
        </mxCell>
        <mxCell id="lg-c2" value="Khối viền xám: cùng VPS" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="870" y="105" width="220" height="18" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
