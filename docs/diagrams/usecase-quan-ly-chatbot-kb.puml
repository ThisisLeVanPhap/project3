@startuml
left to right direction
skinparam packageStyle rectangle

actor "Quản trị cửa hàng" as StoreAdmin
actor "Quản trị hệ thống" as PlatformAdmin

rectangle "Quản lý Chatbot và Knowledge Base" {
  package "Quản lý Chatbot" {
    usecase "Tạo chatbot" as UC1
    usecase "Xem danh sách chatbot" as UC2
    usecase "Cập nhật cấu hình\nchatbot" as UC3
  }

  package "Quản lý Knowledge Base" {
    usecase "Xem danh sách\nnguồn dữ liệu KB" as UC4
    usecase "Thêm source URL\nvào knowledge base" as UC5
    usecase "Xóa source URL\nkhỏi knowledge base" as UC6
    usecase "Rebuild knowledge base" as UC7
    usecase "Xem trạng thái\nknowledge base" as UC8
    usecase "Xem lịch sử rebuild\nknowledge base" as UC9
  }

  package "Giám sát toàn cục" {
    usecase "Theo dõi trạng thái KB\ncác tenant" as UC10
  }
}

StoreAdmin --> UC1
StoreAdmin --> UC2
StoreAdmin --> UC3
StoreAdmin --> UC4
StoreAdmin --> UC5
StoreAdmin --> UC6
StoreAdmin --> UC7
StoreAdmin --> UC8
StoreAdmin --> UC9

PlatformAdmin --> UC10

UC7 ..> UC5 : <<include>>
UC7 ..> UC8 : <<include>>
UC8 ..> UC9 : <<extend>>
@enduml
